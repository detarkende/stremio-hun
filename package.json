{
  "name": "stremio-hun",
  "private": true,
  "description": "A Stremio addon for Hungarian content.",
  "type": "module",
  "module": "index.ts",
  "imports": {
    "#translations/*": "./translations/*",
    "#client/*": "./src/client/*",
    "#server/*": "./src/server/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "NODE_ENV=production node --enable-source-maps --env-file-if-exists .env dist/server/index.mjs",
    "check": "pnpm run typecheck && pnpm run lint:check && pnpm run fmt:check",
    "typecheck": "tsgo --noEmit",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt:check": "oxfmt --check",
    "fmt:fix": "oxfmt",
    "release": "semantic-release",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@logtape/logtape": "^2.2.4",
    "@tanstack/react-router": "^1.169.1",
    "hono": "^4.12.9",
    "lucide-react": "^1.3.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "srvx": "^0.11.15",
    "tmdb-ts": "^2.3.0",
    "undici": "^8.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@logtape/pretty": "^2.2.4",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@standard-schema/spec": "^1.1.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/router-plugin": "^1.167.33",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260419.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "husky": "^9.1.7",
    "nitro": "3.0.260429-beta",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "semantic-release": "^25.0.3",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "packageManager": "pnpm@10.10.0",
  "patchedDependencies": {
    "tmdb-ts@2.3.0": "patches/tmdb-ts@2.3.0.patch",
    "undici@8.1.0": "patches/undici@8.1.0.patch"
  }
}
